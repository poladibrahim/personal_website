---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social card image. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = profile.summary,
  image = '/images/og.png',
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL(image, Astro.site ?? Astro.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: canonical.origin,
  address: { '@type': 'PostalAddress', addressLocality: 'Bonn', addressCountry: 'DE' },
  alumniOf: 'French-Azerbaijani University (UFAZ)',
  worksFor: { '@type': 'Organization', name: 'National AI Center' },
  knowsAbout: ['Machine Learning', 'Information Retrieval', 'Natural Language Processing', 'RAG'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — Blog`}
      href={new URL('/rss.xml', Astro.site ?? Astro.url)}
    />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={profile.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      // Set the theme before first paint so there is no flash of the wrong one.
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored ?? (prefersLight ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
          if (theme === 'light') {
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute('content', '#fbfbfa');
          }
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
