---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/site';
---

<Base
  title="Projects"
  description="Retrieval systems, domain-specific embeddings for a low-resource language, and a quantum-inspired reinforcement learning prototype."
>
  <div class="wrap wrap--narrow">
    <PageHeader
      eyebrow="Projects"
      title="Things I've built"
      lead="Production retrieval systems, research on embeddings for a low-resource language, and the occasional experiment that had no business working."
    />

    <div class="list" data-reveal>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</Base>

<style>
  .list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
