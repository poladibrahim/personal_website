---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getTags, tagSlug } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const [posts, tags] = await Promise.all([getPosts(), getTags()]);
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === slug)) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<Base title={`Posts tagged “${tag}”`} description={`Everything I've written about ${tag}.`}>
  <div class="wrap wrap--narrow">
    <PageHeader
      eyebrow="Tag"
      title={tag}
      lead={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged “${tag}”.`}
    />

    <div class="posts" data-reveal>
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <p class="back-link">
      <a class="link-inline" href="/blog/">← Back to all posts</a>
    </p>
  </div>
</Base>

<style>
  .posts {
    display: grid;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .back-link {
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }
</style>
