---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/site';
import { getPosts, formatDate, readingTime, tagSlug } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are newest-first, so the "newer" post is the previous index.
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<Base title={title} description={description} type="article" publishedTime={pubDate}>
  <article class="wrap wrap--narrow">
    <header class="post-head" data-reveal>
      <a class="back" href="/blog/">
        <Icon name="arrow" size={15} class="back__icon" /> All posts
      </a>

      <h1 class="post-head__title">{title}</h1>

      <div class="post-head__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <ul class="tags post-head__tags">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose post-body">
      <Content />
    </div>

    <footer class="post-foot">
      <div class="byline">
        <p class="byline__name">Written by {profile.name}</p>
        <p class="byline__role">{profile.role} · {profile.location}</p>
        <a class="link-inline" href="/about/">More about me →</a>
      </div>

      {
        (newer || older) && (
          <nav class="siblings" aria-label="More posts">
            {older && (
              <a class="sibling" href={`/blog/${older.id}/`}>
                <span class="sibling__label">← Older</span>
                <span class="sibling__title">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a class="sibling sibling--next" href={`/blog/${newer.id}/`}>
                <span class="sibling__label">Newer →</span>
                <span class="sibling__title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .post-head {
    padding-top: 2.5rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .back:hover {
    color: var(--accent-text);
  }

  :global(.back__icon) {
    transform: rotate(180deg);
  }

  .post-head__title {
    margin-top: 1.1rem;
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    letter-spacing: -0.035em;
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.8rem;
    font-family: var(--font-code);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .post-head__tags {
    margin-top: 1rem;
    list-style: none;
    padding: 0;
  }

  .post-body {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }

  .post-foot {
    margin-top: 3.5rem;
  }

  .byline {
    padding: 1.35rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .byline__name {
    font-weight: 600;
  }

  .byline__role {
    margin-top: 0.15rem;
    margin-bottom: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .siblings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .sibling {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .sibling:hover {
    border-color: var(--accent-ring);
    background: var(--surface-hover);
  }

  .sibling--next {
    text-align: right;
  }

  .sibling__label {
    font-family: var(--font-code);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .sibling__title {
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.45;
  }
</style>
