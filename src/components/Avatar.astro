---
import { profile } from '../data/site';

interface Props {
  size?: number;
}

const { size = 116 } = Astro.props;
---

<div class="avatar" style={`--size:${size}px`}>
  {
    profile.avatar ? (
      <img src={profile.avatar} alt={profile.name} width={size} height={size} loading="eager" />
    ) : (
      <span class="avatar__initials" aria-hidden="true">
        {profile.initials}
      </span>
    )
  }
</div>

<style>
  .avatar {
    position: relative;
    width: var(--size);
    height: var(--size);
    border-radius: 999px;
    padding: 3px;
    background: conic-gradient(
      from 210deg,
      var(--accent),
      #7aa2ff 40%,
      color-mix(in srgb, var(--accent) 40%, transparent) 70%,
      var(--accent)
    );
    display: grid;
    place-items: center;
  }

  .avatar::after {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: inherit;
    background: radial-gradient(circle, var(--accent-soft), transparent 68%);
    z-index: -1;
  }

  .avatar :global(img),
  .avatar__initials {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  .avatar__initials {
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-code);
    font-size: calc(var(--size) * 0.3);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
</style>
