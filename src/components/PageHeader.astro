---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-head" data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-head__title">{title}</h1>
  {lead && <p class="page-head__lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-top: 3.5rem;
    padding-bottom: 0.5rem;
  }

  .page-head__title {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 5vw, 2.6rem);
    letter-spacing: -0.035em;
  }

  .page-head__lead {
    margin-top: 0.9rem;
    max-width: 44rem;
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
